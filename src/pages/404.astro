---
import Layout from '../layouts/Layout.astro';
import InviteLanding from '../components/InviteLanding.astro';
---

<Layout
  title="Page not found · TinyAct"
  description="This page doesn't exist on TinyAct."
>
  <div id="invite-fallback" hidden>
    <InviteLanding />
  </div>

  <main class="not-found" id="not-found">
    <div class="card">
      <div class="logo">
        <img src="/favicon.png" alt="TinyAct" width="64" height="64" />
        <h1>TinyAct</h1>
      </div>
      <h2>Page not found</h2>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="btn-primary">Go to tinyact.app</a>
    </div>
  </main>
  <script is:inline>
    // GitHub Pages serves 404.html for arbitrary invite codes. Render the
    // invite here so its URL and code survive without a redirect.
    if (/^\/join\/[^/]+\/?$/.test(window.location.pathname)) {
      document.getElementById('invite-fallback').hidden = false;
      document.getElementById('not-found').hidden = true;
      document.getElementById('not-found').removeAttribute('id');
      document.title = "Open in TinyAct · You're invited";
    } else {
      document.querySelector('#invite-fallback #main-content').removeAttribute('id');
      document.getElementById('not-found').id = 'main-content';
    }
  </script>
  <noscript>
    <p>For a TinyAct invite, <a href="/join/">open the invite page</a> to find links to the App Store and Google Play.</p>
  </noscript>
</Layout>

<style>
  [hidden] { display: none !important; }
  .not-found {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #f5f5f7;
  }

  .card {
    background: white;
    border-radius: 20px;
    padding: 40px 32px;
    max-width: 400px;
    width: 100%;
    text-align: center;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
  }

  .logo h1 {
    font-size: 22px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  h2 {
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 12px;
  }

  p {
    font-size: 15px;
    color: #666;
    margin: 0 0 32px;
    line-height: 1.5;
  }

  .btn-primary {
    display: block;
    background: #FF6B5A;
    color: white;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    transition: opacity 0.15s;
  }

  .btn-primary:hover { opacity: 0.9; }
</style>
