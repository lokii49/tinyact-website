---
// Final CTA — the conversion moment
---

<section class="final-cta section-lg" id="download">
  <div class="container">
    <div class="cta-content reveal">
      <div class="cta-dots" aria-hidden="true">
        <i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i>
      </div>

      <h2>Stop building habits alone</h2>
      <p class="cta-sub">
        Download TinyAct and pair with someone who'll hold you accountable.
        When their streak depends on you, showing up becomes automatic.
      </p>

      <div class="cta-buttons">
        <a href="https://apps.apple.com/app/tinyact" class="store-badge store-badge-light" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <div class="store-badge-text">
            <span class="store-badge-sub">Download on the</span>
            <span class="store-badge-name">App Store</span>
          </div>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.lokesh.Tinyact" class="store-badge store-badge-light" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3,20.5V3.5C3,2.91 3.34,2.36 3.84,2.07L13.69,12L3.84,21.93C3.34,21.64 3,21.09 3,20.5M16.81,15.12L13.7,12L16.81,8.88L20.61,11.07C21.67,11.67 21.67,12.33 20.61,12.93L16.81,15.12M5.57,23.09L14.18,14.5L16.81,15.12L7.68,21.5C6.77,22.03 5.89,22.21 5.57,23.09M5.57,0.91C5.89,1.79 6.77,1.97 7.68,2.5L16.81,8.88L14.18,9.5L5.57,0.91Z"/>
          </svg>
          <div class="store-badge-text">
            <span class="store-badge-sub">Get it on</span>
            <span class="store-badge-name">Google Play</span>
          </div>
        </a>
      </div>

      <div class="cta-meta">
        <span>Free forever</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>No credit card</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>4.8★ on the App Store</span>
      </div>

      <p class="cta-tagline">The habit app where quitting doesn't just affect you.</p>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: var(--night);
    color: var(--ink-inverse);
    text-align: center;
  }

  .cta-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-dots {
    display: inline-flex;
    gap: 8px;
    margin-bottom: var(--space-6);
  }

  .cta-dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: transparent;
    border: 1.5px solid var(--night-line);
  }

  .cta-dots i.on {
    background: var(--coral);
    border-color: var(--coral);
  }

  .final-cta h2 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink-inverse);
    margin-bottom: var(--space-5);
  }

  .cta-sub {
    font-size: var(--text-lg);
    color: var(--ink-inverse-soft);
    margin-bottom: var(--space-8);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .store-badge-light {
    background: var(--ink-inverse);
    color: var(--night);
  }

  .cta-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-inverse-soft);
    margin-bottom: var(--space-10);
  }

  .meta-sep {
    color: var(--night-line);
  }

  .cta-tagline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--coral);
  }

  @media (max-width: 640px) {
    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .cta-meta {
      flex-wrap: wrap;
    }
  }
</style>
