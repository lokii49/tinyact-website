---
// Header component with navigation
---

<header class="header">
  <nav class="nav container">
    <a href="/" class="logo" aria-label="TinyAct Home">
      <div class="logo-icon">
        <img src="/favicon.png" alt="" width="32" height="32" loading="eager">
      </div>
      <span class="logo-text">TinyAct</span>
    </a>

    <div class="nav-links hide-mobile">
      <a href="#how-it-works">How it works</a>
      <a href="#accountability">Accountability</a>
      <a href="#features">Features</a>
    </div>

    <div class="nav-cta hide-mobile">
      <a href="#download" class="btn btn-primary btn-nav">Get the app</a>
    </div>

    <button class="mobile-menu-btn hide-desktop" aria-label="Open menu" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu hide-desktop" id="mobile-menu">
    <a href="#how-it-works">How it works</a>
    <a href="#accountability">Accountability</a>
    <a href="#features">Features</a>
    <a href="#download" class="btn btn-primary">Get the app</a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 251, 248, 0.88);
    backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header.scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 4px 24px rgba(38, 21, 15, 0.05);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    max-width: var(--container-max);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    background: var(--ink);
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  .logo-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .nav-links {
    display: flex;
    gap: var(--space-10);
  }

  .nav-links a {
    color: var(--ink-soft);
    font-weight: 500;
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }

  .nav-links a:hover {
    color: var(--coral-text);
  }

  .btn-nav {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
  }

  .mobile-menu-btn {
    padding: var(--space-2);
    color: var(--ink);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-menu a {
    padding: var(--space-3) 0;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .mobile-menu a.btn {
    color: #fff;
    margin-top: var(--space-2);
  }

  @media (max-width: 768px) {
    .nav {
      padding: var(--space-3) var(--space-4);
    }
  }
</style>

<script>
  // Header scroll effect
  const header = document.querySelector('.header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Mobile menu toggle
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(isOpen));
  });

  // Close menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
