---
// Hero — thesis: tiny acts, shared stakes. The linked-streak demo shows the
// motto (one miss resets both) instead of describing it.
---

<section class="hero" id="main-content">
  <div class="container hero-container">
    <div class="hero-content">
      <span class="eyebrow">Free on iOS &amp; Android</span>

      <h1>
        Tiny acts.<br>
        <span class="hero-accent">Shared stakes.</span>
      </h1>

      <p class="hero-subtitle">
        Pick a habit too small to skip. Link your streak to a partner's.
        If one of you misses a day, <strong>both streaks reset to zero</strong> —
        so quitting stops being private.
      </p>

      <div class="hero-cta">
        <a href="https://apps.apple.com/app/tinyact" class="store-badge" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <div class="store-badge-text">
            <span class="store-badge-sub">Download on the</span>
            <span class="store-badge-name">App Store</span>
          </div>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.lokesh.Tinyact" class="store-badge" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3,20.5V3.5C3,2.91 3.34,2.36 3.84,2.07L13.69,12L3.84,21.93C3.34,21.64 3,21.09 3,20.5M16.81,15.12L13.7,12L16.81,8.88L20.61,11.07C21.67,11.67 21.67,12.33 20.61,12.93L16.81,15.12M5.57,23.09L14.18,14.5L16.81,15.12L7.68,21.5C6.77,22.03 5.89,22.21 5.57,23.09M5.57,0.91C5.89,1.79 6.77,1.97 7.68,2.5L16.81,8.88L14.18,9.5L5.57,0.91Z"/>
          </svg>
          <div class="store-badge-text">
            <span class="store-badge-sub">Get it on</span>
            <span class="store-badge-name">Google Play</span>
          </div>
        </a>
      </div>

      <div class="hero-trust">
        <span class="trust-stars" aria-label="4.8 out of 5 stars">★★★★★</span>
        <span class="trust-rating">4.8</span>
        <span class="trust-sep">·</span>
        <span class="trust-text">Free forever. No credit card.</span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="phone">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <img src="/screenshots/screen-my-goals.png" alt="TinyAct My Goals screen showing active streaks and commitments" loading="eager" fetchpriority="high">
        </div>
      </div>

      <!-- Signature: linked-streak demo. One miss resets both. -->
      <div class="streak-demo" id="streak-demo" aria-label="Demo: when one partner misses a day, both streaks reset to zero">
        <div class="demo-head">
          <span class="demo-title">Linked streak</span>
          <span class="demo-day" id="demo-day">DAY 01</span>
        </div>

        <div class="demo-row" data-row="you">
          <span class="demo-avatar demo-avatar-you">Y</span>
          <span class="demo-name">You</span>
          <span class="demo-dots">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </span>
        </div>

        <div class="demo-row" data-row="partner">
          <span class="demo-avatar demo-avatar-partner">M</span>
          <span class="demo-name">Maya</span>
          <span class="demo-dots">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </span>
        </div>

        <div class="demo-foot">
          <span class="demo-msg demo-msg-ok" id="demo-msg-ok">Both on track</span>
          <span class="demo-msg demo-msg-reset" id="demo-msg-reset">Maya missed — both reset to 0</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 9rem 0 5rem;
    background:
      radial-gradient(ellipse 70% 55% at 85% 15%, rgba(255, 107, 90, 0.07) 0%, transparent 60%),
      var(--paper);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    max-width: 540px;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    margin: var(--space-5) 0 var(--space-6);
    color: var(--ink);
  }

  .hero-accent {
    color: var(--coral-deep);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    margin-bottom: var(--space-8);
    max-width: 46ch;
  }

  .hero-subtitle strong {
    color: var(--ink);
    font-weight: 600;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .hero-trust {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .trust-stars {
    color: var(--yellow);
    letter-spacing: 1px;
  }

  .trust-rating {
    font-weight: 700;
    color: var(--ink);
  }

  .trust-sep {
    color: var(--ink-faint);
  }

  .trust-text {
    color: var(--ink-soft);
  }

  /* Visual */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    padding: var(--space-6) 0 var(--space-10);
  }

  .phone {
    width: 270px;
    background: #1b1b1f;
    border-radius: 40px;
    padding: 7px;
    transform: rotate(3deg);
    box-shadow:
      0 30px 60px -18px rgba(38, 21, 15, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .phone-notch {
    position: absolute;
    top: 13px;
    left: 50%;
    transform: translateX(-50%);
    width: 82px;
    height: 22px;
    background: #000;
    border-radius: 11px;
    z-index: 10;
  }

  .phone-screen {
    background: #000;
    border-radius: 33px;
    overflow: hidden;
  }

  /* Linked-streak demo card */
  .streak-demo {
    position: absolute;
    left: 0;
    bottom: var(--space-4);
    width: 280px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-5);
    z-index: 5;
  }

  .streak-demo.shake {
    animation: demo-shake 0.5s ease;
  }

  @keyframes demo-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-5px); }
    40% { transform: translateX(5px); }
    60% { transform: translateX(-3px); }
    80% { transform: translateX(3px); }
  }

  .demo-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .demo-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .demo-day {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--coral-text);
    background: var(--coral-tint);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .demo-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
  }

  .demo-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }

  .demo-avatar-you {
    background: var(--coral);
  }

  .demo-avatar-partner {
    background: var(--purple);
  }

  .demo-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    width: 42px;
  }

  .demo-dots {
    display: inline-flex;
    gap: 7px;
    margin-left: auto;
  }

  .demo-dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--paper-warm);
    border: 1.5px solid var(--line-strong);
    transition: background var(--transition-base), border-color var(--transition-base), transform var(--transition-base);
    position: relative;
  }

  .demo-dots i.on {
    background: var(--green);
    border-color: var(--green);
    transform: scale(1.05);
  }

  .demo-dots i.miss {
    background: var(--coral-deep);
    border-color: var(--coral-deep);
  }

  .demo-dots i.miss::after {
    content: '✕';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 7px;
    font-weight: 800;
    color: #fff;
  }

  .demo-foot {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    min-height: 1.5rem;
    position: relative;
  }

  .demo-msg {
    position: absolute;
    inset: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.03em;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .demo-msg-ok {
    color: var(--green-deep);
  }

  .demo-msg-reset {
    color: var(--coral-text);
  }

  .demo-msg.show {
    opacity: 1;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero {
      padding: 7.5rem 0 3.5rem;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      text-align: center;
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-cta,
    .hero-trust {
      justify-content: center;
    }

    .hero-visual {
      max-width: 480px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 6.5rem 0 2.5rem;
    }

    .hero-cta {
      flex-direction: column;
      align-items: center;
    }

    .phone {
      width: 220px;
      transform: rotate(0deg);
    }

    .hero-visual {
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
      padding-bottom: 0;
    }

    .streak-demo {
      position: static;
      width: 100%;
      max-width: 300px;
    }
  }
</style>

<script>
  // Linked-streak demo: dots fill day by day; on day 5 the partner misses,
  // the card shakes, and both rows drain to zero. Loops.
  const demo = document.getElementById('streak-demo');
  const dayEl = document.getElementById('demo-day');
  const msgOk = document.getElementById('demo-msg-ok');
  const msgReset = document.getElementById('demo-msg-reset');
  const youDots = demo?.querySelectorAll('[data-row="you"] .demo-dots i');
  const partnerDots = demo?.querySelectorAll('[data-row="partner"] .demo-dots i');

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (demo && dayEl && youDots && partnerDots) {
    if (reducedMotion) {
      // Static state: day 5, partner missed, message visible
      for (let i = 0; i < 5; i++) youDots[i].classList.add('on');
      for (let i = 0; i < 4; i++) partnerDots[i].classList.add('on');
      partnerDots[4].classList.add('miss');
      dayEl.textContent = 'DAY 05';
      msgReset?.classList.add('show');
    } else {
      const MISS_DAY = 5;
      let day = 0;
      let phase = 'fill';

      const clear = () => {
        youDots.forEach(d => d.classList.remove('on', 'miss'));
        partnerDots.forEach(d => d.classList.remove('on', 'miss'));
      };

      const tick = () => {
        if (phase === 'fill') {
          day++;
          dayEl.textContent = 'DAY ' + String(day).padStart(2, '0');

          if (day < MISS_DAY) {
            youDots[day - 1].classList.add('on');
            partnerDots[day - 1].classList.add('on');
            msgOk?.classList.add('show');
            msgReset?.classList.remove('show');
            setTimeout(tick, 750);
          } else {
            // The miss: you check in, partner doesn't
            youDots[day - 1].classList.add('on');
            partnerDots[day - 1].classList.add('miss');
            msgOk?.classList.remove('show');
            setTimeout(() => {
              demo.classList.add('shake');
              msgReset?.classList.add('show');
              setTimeout(() => demo.classList.remove('shake'), 550);
              phase = 'reset';
              setTimeout(tick, 1900);
            }, 650);
          }
        } else {
          // Drain and restart
          clear();
          day = 0;
          dayEl.textContent = 'DAY 00';
          msgReset?.classList.remove('show');
          phase = 'fill';
          setTimeout(tick, 1100);
        }
      };

      // Start when visible
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          setTimeout(tick, 600);
        }
      }, { threshold: 0.4 });
      observer.observe(demo);
    }
  }
</script>
