---
// Widgets showcase — real widget screenshots from the shipping iOS app
---

<section class="widgets section">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">Widgets</span>
      <h2>Your streak, on your home screen</h2>
      <p>Check in without opening the app. One tap from the widget logs your day.</p>
    </div>

    <div class="widgets-showcase reveal">
      <div class="widget-shot small">
        <img src="/screenshots/widget-streak-small-crop.png" alt="TinyAct small widget showing a 1-day streak at 100% with check-in complete" loading="lazy" width="375" height="374">
      </div>
      <div class="widget-shot small">
        <img src="/screenshots/widget-activity-crop.png" alt="TinyAct activity widget showing 2 check-ins and reactions" loading="lazy" width="375" height="374">
      </div>
      <div class="widget-shot medium">
        <img src="/screenshots/widget-quick-checkin-crop.png" alt="TinyAct quick check-in widget listing two commitments marked done" loading="lazy" width="793" height="375">
      </div>
    </div>

    <p class="widgets-note reveal">Straight from the app — small, medium, and large sizes on iOS.</p>
  </div>
</section>

<style>
  .widgets {
    background: var(--paper-warm);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .widgets-showcase {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .widget-shot {
    /* matches the widget's own corner radius (~65px native at 49% scale) so
       no home-screen wallpaper shows at the corners */
    border-radius: 34px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
    background: var(--card);
    transition: transform var(--transition-spring), box-shadow var(--transition-spring);
  }

  .widget-shot:hover {
    transform: translateY(-4px) scale(1.02);
  }

  .widget-shot img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .widget-shot.small {
    width: 184px;
    height: 184px;
  }

  .widget-shot.medium {
    width: 389px;
    height: 184px;
  }

  .widgets-note {
    text-align: center;
    margin-top: var(--space-10);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .widget-shot {
      border-radius: 28px;
    }

    .widget-shot.small {
      width: 150px;
      height: 150px;
    }

    .widget-shot.medium {
      width: 317px;
      height: 150px;
    }
  }
</style>
